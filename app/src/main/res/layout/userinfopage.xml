<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select your age, weight,\ngender and height"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textColor="@color/black"
            android:gravity="center"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp" />

        <!-- Gender Selection -->
        <TextView
            android:id="@+id/tvGender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What is your gender"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textColor="@color/black"
            android:layout_marginBottom="2dp" />

        <LinearLayout
            android:id="@+id/genderGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="2dp">

            <!-- Male -->
            <FrameLayout
                android:id="@+id/genderMaleContainer"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivMale"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:src="@drawable/male_unselected"/>


            </FrameLayout>

            <!-- Female -->
            <FrameLayout
                android:id="@+id/genderFemaleContainer"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivFemale"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:src="@drawable/female_unselected"/>


            </FrameLayout>

            <!-- Other -->
        </LinearLayout>

        <!-- Age Slider -->
        <TextView
            android:id="@+id/tvAge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How old are you :"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textColor="@color/black"
            android:layout_marginLeft="8dp"
            android:layout_gravity="start"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderAge"
                style="@style/Widget.ThinSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="0"
                android:valueTo="100"
                android:value="20"
                android:stepSize="1"/>

            <TextView
                android:id="@+id/tvAgeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100"
                android:textColor="@color/primary"
                android:textAppearance="?attr/textAppearanceBody1"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Weight Slider -->
        <TextView
            android:id="@+id/tvWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What is your weight (in kg) :"
            android:textStyle="bold"
            android:layout_gravity="start"
            android:layout_marginLeft="8dp"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textColor="@color/black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderWeight"
                style="@style/Widget.ThinSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="0"
                android:valueTo="200"
                android:value="57"
                android:stepSize="0.1"/>

            <TextView
                android:id="@+id/tvWeightValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                android:text="57"
                android:textAppearance="?attr/textAppearanceBody1"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Height Slider -->
        <TextView
            android:id="@+id/tvHeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What is your height (in cm) :"
            android:layout_gravity="start"
            android:textStyle="bold"
            android:layout_marginLeft="8dp"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textColor="@color/black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderHeight"
                style="@style/Widget.ThinSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="0"
                android:valueTo="300"
                android:value="175"
                android:stepSize="0.1"/>

            <TextView
                android:id="@+id/tvHeightValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="125"
                android:textColor="@color/primary"
                android:textAppearance="?attr/textAppearanceBody1"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Time Pickers Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">

            <!-- Wake up time -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWakeup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Wake up time"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceSubtitle1"
                    android:gravity="center"
                    android:textColor="@color/black" />

                <TimePicker
                    android:id="@+id/timePickerWakeup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:timePickerMode="spinner"
                    android:numbersTextColor="@color/primary"
                    android:theme="@style/Widget.MaterialComponents.TimePicker" />
            </LinearLayout>

            <!-- Sleeping time -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSleep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sleeping time"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceSubtitle1"
                    android:textColor="@color/black" />

                <TimePicker
                    android:id="@+id/timePickerSleep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:timePickerMode="spinner"
                    android:theme="@style/Widget.MaterialComponents.TimePicker" />
            </LinearLayout>
        </LinearLayout>

        <!-- Navigation Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">




            <Button
                android:id="@+id/btnDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Done"
                android:gravity="center"
                android:backgroundTint="@color/primary"
                android:textColor="@android:color/white" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>