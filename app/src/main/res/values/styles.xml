<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.ThinSlider" parent="Widget.MaterialComponents.Slider">
        <item name="trackHeight">2dp</item>
        <item name="thumbRadius">8dp</item>
        <item name="trackColorActive">@color/primary</item>
        <item name="trackColorInactive">@color/primary</item>
        <item name="thumbColor">@color/primary</item>
        <item name="thumbStrokeColor">@android:color/transparent</item>
    </style>

    <!-- Add this theme overlay -->
    <style name="CustomTimePickerTheme" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <!-- Clock Mode (numbers color) -->
        <item name="colorOnSurface">@color/black</item>
        <!-- Selection and clock hand color -->
        <item name="colorPrimary">@color/primary</item>
        <!-- Spinner Mode (numbers color) -->
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/black</item>
        <!-- No problematic text appearance attributes! -->
    </style>

    <style name="ClockNumberText" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/timepicker_black</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TitleText" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/timepicker_black</item>
    </style>
    <!-- Button Styles - Updated with modern styling -->
    <style name="Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/button_rounded</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:background">@drawable/button_outlined_rounded</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <!-- Text Styles - Enhanced typography -->
    <style name="Text.Heading" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Text.Subheading" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Card Styles - Enhanced cards -->
    <style name="Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPadding">16dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="rippleColor">@color/primary_light</item>
    </style>
</resources> 